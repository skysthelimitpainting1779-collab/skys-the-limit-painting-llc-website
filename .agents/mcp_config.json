{
  "mcpServers": {
    "devhealer": {
      "command": "python",
      "args": [
        ".agents/plugins/dev-healer/mcp/server.py"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy",
        "graphify-mcp",
        "graphify-out/graph.json"
      ]
    },
    "agentgraph-dev": {
      "command": "python",
      "args": [
        "scripts/execution/start_agentgraph_mcp.py"
      ],
      "cwd": "."
    }
  }
}
